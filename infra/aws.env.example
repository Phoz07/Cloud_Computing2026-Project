# Learner Lab credentials — the ONLY place they go. Copy this file to
# infra/aws.env (gitignored) and paste the three values from
# Learner Lab → AWS Details → "AWS CLI:" (they rotate every session, ~4 h).
# Every Make target and script that touches AWS sources this file; Terraform
# and the AWS CLI read the same variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
