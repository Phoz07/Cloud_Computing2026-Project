{
  "name": "cloud-project",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "bun run --filter @app/db db:generate",
    "db:migrate": "bun run --filter @app/db db:migrate",
    "db:studio": "bun run --filter @app/db db:studio",
    "dev": "bun run --parallel --filter './apps/*' dev",
    "stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:5173/api/payment/webhook",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@stripe/cli": "^1.55.1",
    "@types/bun": "^1.4.3",
    "shadcn": "^4.22.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
