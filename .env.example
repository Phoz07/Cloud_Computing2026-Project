POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

DATABASE_URL=postgres://postgres:postgres@localhost:5432/db
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=event-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

AWS_REGION=ap-southeast-1
# ElasticMQ accepts any credentials; the AWS SDK just needs some to sign requests
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_ENDPOINT=http://localhost:9324
MAIL_QUEUE_URL=http://localhost:9324/000000000000/mail-queue

# auth service: public origin the browser uses (the Vite dev server proxies /api/auth)
BETTER_AUTH_URL=http://localhost:5173
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# where the other services ask "who is this cookie?" (@app/auth-guard); internal URL, not the browser origin
AUTH_SERVICE_URL=http://localhost:3001
# optional; Google login is enabled only when both are set
# redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# payment service: a sandbox key, rk_test_... (restricted, recommended) or sk_test_...;
# live keys are refused outside production. Setup: docs/stripe.md
STRIPE_SECRET_KEY=
# signs the Checkout events Stripe posts to the webhook; in dev, copy the whsec_... that
# `bun run stripe:listen` prints (unset = every event refused)
STRIPE_WEBHOOK_SECRET=

# mail worker: Gmail address + 16-char App Password (requires 2-Step Verification)
# when unset, the worker logs mail instead of sending it
# the sending account, e.g. you@gmail.com (personal Gmail; Workspace admins can disable App Passwords)
GMAIL_USER=
# create at https://myaccount.google.com/apppasswords (shown once; spaces optional)
GMAIL_APP_PASSWORD=
# optional "From" header, e.g. "Eventide <you@gmail.com>"; defaults to GMAIL_USER
# use the GMAIL_USER address, since Gmail rewrites any other unless it's added under "Send mail as"
MAIL_FROM=