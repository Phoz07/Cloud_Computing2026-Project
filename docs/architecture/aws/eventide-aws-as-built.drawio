<mxCell id="auth" value="&lt;b&gt;auth&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;/api/auth · ×2&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;Better Auth, roles, bans&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#ED7100;fillColor=#FFF3E0;fontColor=#232F3E;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1130" y="625" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="registration" value="&lt;b&gt;registration&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;/api/regis · ×2&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;seats, holds, WebSocket live seats&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#ED7100;fillColor=#FFF3E0;fontColor=#232F3E;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1130" y="725" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="payment" value="&lt;b&gt;payment&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;/api/payment · ×1&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;Stripe checkout, webhook, refunds&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#ED7100;fillColor=#FFF3E0;fontColor=#232F3E;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1130" y="825" width="190" height="80" as="geometry"/></mxCell>
