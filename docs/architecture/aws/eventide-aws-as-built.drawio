<mxCell id="ingress" value="&lt;b&gt;ingress-nginx ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;NodePort 30080 / 30443&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;body limit 20m&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#444444&#x27;&gt;WebSocket timeout 3600s&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#ED7100;fillColor=#FFF3E0;fontColor=#232F3E;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="870" y="645" width="150" height="110" as="geometry"/></mxCell>
